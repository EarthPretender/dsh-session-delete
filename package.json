{
  "name": "dsh-session-delete",
  "description": "会话删除插件：在会话“…”菜单的“归档会话”下新增红色的“删除会话”行，二次点击确认后删除该会话的全部日志数据并从工作区登记中移除（不可逆；当次启动使用过的会话先从内存停用再删，正在执行任务的会话会先提醒、再点一次停止任务并删除）。",
  "version": "0.2.0",
  "type": "module",
  "author": "EarthPretender",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EarthPretender/dsh-session-delete.git"
  },
  "homepage": "https://github.com/EarthPretender/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/EarthPretender/dsh-session-delete/issues"
  },
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "session",
    "session-management"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/selftest.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "MIT"
}
